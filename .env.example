# ============================================================================
# SkySurvey SPHEREx Backend Configuration (.env)
# ============================================================================

# --- Supabase (PostgreSQL + Storage) ---
SUPABASE_URL=
SUPABASE_KEY=sb_publishable_7lCBBmZOe_7qAi9aO0Hz7Q_YMMMrrIx
SUPABASE_BUCKET=skysurvey

# --- Local FITS Cache (/tmp/fits_cache) ---
CACHE_DIR=/tmp/fits_cache
CACHE_TTL_S=1800
CACHE_MAX_BYTES=524288000

# --- IRSA & Concurrency Tuning ---
IRSA_TAP_URL=https://irsa.ipac.caltech.edu/TAP
DOWNLOAD_CONCURRENCY=6
UPLOAD_CONCURRENCY=8
MAX_FRAMES_PER_DETECTOR_PER_EPOCH=2
SPECTRUM_MAX_FRAMES=160

# --- Rendering ---
PNG_SIZE=512
PNG_RESAMPLE=nearest
